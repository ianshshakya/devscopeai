# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/devscope

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# JWT secret (generate a random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here

# AI Provider — set one of the following
# DeepSeek (recommended — cheaper)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which AI provider to use: "deepseek" | "openai"
AI_PROVIDER=deepseek

# ─── Client ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ─── Optional: Stripe (for premium plans) ─────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
